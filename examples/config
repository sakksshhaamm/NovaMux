# NovaMux configuration is local, declarative, and offline.
theme = default
# `subtle` gently pulses RGB focus/status accents at 8 Hz. Use `off` for
# accessibility, maximum stillness, or constrained terminals.
animation = off

# Names: black, red, green, yellow, blue, magenta, cyan, white,
# dark-grey, grey. Exact 24-bit colors use #RRGGBB.
pane_border = dark-grey
focused_border = cyan
status = black
status_background = cyan
foreground = white
background = black
